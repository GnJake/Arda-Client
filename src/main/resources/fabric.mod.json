{
  "schemaVersion": 1,
  "id": "arda-client",
  "version": "${version}",
  "name": "Arda Client",
  "description": "Quality-of-life tools for the Arda server: quick wheel, dungeon timers, currency counter, and item prices. Adds extra features when Meteor Client is installed.",
  "authors": [
    "GnJake"
  ],
  "contact": {
    "sources": "https://github.com/GnJake/Arda-Client"
  },
  "icon": "assets/arda-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.gnjake.ardaclient.ArdaClient"
    ],
    "meteor": [
      "com.gnjake.ardaclient.meteor.ArdaMeteorAddon"
    ]
  },
  "mixins": [
    "arda-client.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "198,40,40"
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=0.158.0"
  },
  "suggests": {
    "meteor-client": "*",
    "xaerominimap": "*",
    "xaeroworldmap": "*"
  }
}
